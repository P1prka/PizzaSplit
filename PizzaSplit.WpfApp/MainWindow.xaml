<Window x:Class="PizzaSplit.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PizzaSplit"
        Height="250"
        Width="300">

    <StackPanel>

        <TextBlock Text="Tellimuse summa (€):"/>
        <TextBox x:Name="TotalTextBox"/>

        <TextBlock Text="Sööjate arv:"/>
        <TextBox x:Name="PeopleTextBox"/>

        <CheckBox x:Name="TipCheckBox"
                  Content="Lisa 10% jootraha"/>

        <Button Content="Arvuta"
                Click="Calculate_Click"/>

        <TextBlock x:Name="ResultTextBlock"/>

        <TextBlock x:Name="ErrorTextBlock"/>

    </StackPanel>
</Window>